Function Sort_(rng As Variant, ParamArray arg() As Variant)
    Dim Arr As Variant
    Dim arrArg As Variant
    Dim crit As Variant
    Dim asc() As Long
    Dim i As Long
    Dim cr As Long
    Dim argCnt As Long
    Dim maxRow As Long
    Dim maxCol As Long
    Dim maxDim As Long
    Dim maxDim2 As Long
    Dim sortByCol As Boolean
    Dim singleCrit As Boolean
    Dim critColNums() As Long
    
    Arr = rng
    Call repairArray(Arr)
    maxRow = UBound(Arr, 1)
    maxCol = UBound(Arr, 2)
    
    If maxRow > MAXINDEXROW Or maxCol > MAXINDEXCOLUMN Then
        Sort_ = "#OVERFLOW"
Exit Function
    End If
    
    
    argCnt = UBound(arg)
    
    If argCnt > 2 Then
        EXIT_BY_ERROR
    End If
    
    'check by_col
    If argCnt >= 2 Then
        If IsMissing(arg(2)) Then
            sortByCol = False
            maxDim = maxRow
            maxDim2 = maxCol
        Else
            If arg(2) Then
                sortByCol = True
                maxDim = maxCol
                maxDim2 = maxRow
            Else
                sortByCol = False
                maxDim = maxRow
                maxDim2 = maxCol
            End If
        End If
    Else
        sortByCol = False
        maxDim = maxRow
        maxDim2 = maxCol
    End If
    
    'sorting criteria
    If argCnt >= 0 Then
        If IsMissing(arg(0)) Then
            ReDim critColNums(1 To 1)
            critColNums(1) = 1
        Else
            If IsArray(arg(0)) Then
                Call getArg(arg(0), critColNums)
            Else
                ReDim critColNums(1 To 1)
                critColNums(1) = arg(0)
            End If
        End If
    Else
        ReDim critColNums(1 To 1)
        critColNums(1) = 1
    End If
    
    For i = 1 To UBound(critColNums, 1)
        If critColNums(i) < 1 Or critColNums(i) > maxDim2 Then EXIT_BY_ERROR
    Next
    
    'sorting directions
    If argCnt >= 1 Then
        If IsArray(arg(1)) Then
            Call getArg(arg(1), asc)
            If UBound(asc, 1) <> UBound(critColNums, 1) Then EXIT_BY_ERROR
        Else
            ReDim asc(1 To 1)
            If IsMissing(arg(1)) Then
                asc(1) = 1
            Else
                asc(1) = arg(1)
            End If
        End If
    Else
        ReDim asc(1 To 1)
        asc(1) = 1
    End If
    ReDim Preserve asc(1 To UBound(critColNums))
    
    ReDim crit(1 To UBound(critColNums, 1), 1 To maxDim)
    
    'build criteria arrays
    If sortByCol Then
        For cr = 1 To UBound(critColNums, 1)
            For i = 1 To maxDim
                crit(cr, i) = Arr(critColNums(cr), i)
            Next
        Next
    Else
        For cr = 1 To UBound(critColNums, 1)
            For i = 1 To maxDim
                crit(cr, i) = Arr(i, critColNums(cr))
            Next
        Next
    End If
            
    Sort_ = arSort(Arr, crit, asc, maxDim, sortByCol)
End Function

Function Sortby(rng As Variant, ParamArray arg() As Variant)
    Dim Arr As Variant
    Dim arrArg As Variant
    Dim crit As Variant
    Dim asc() As Long
    Dim i As Long
    Dim cr As Long
    Dim argCnt As Long
    Dim crCnt As Long
    Dim maxRow As Long
    Dim maxCol As Long
    Dim maxrowCrit As Long
    Dim maxcolCrit As Long
    Dim maxDim As Long
    Dim maxDim2 As Long
    Dim sortByCol As Boolean
    Dim singleCrit As Boolean
    
    Arr = rng
    Call repairArray(Arr)
    maxRow = UBound(Arr, 1)
    maxCol = UBound(Arr, 2)
    
    If maxRow > MAXINDEXROW Or maxCol > MAXINDEXCOLUMN Then
        Sortby = "#OVERFLOW"
Exit Function
    End If
    
    sortByCol = False
    maxDim = maxRow
    
    argCnt = UBound(arg)
    
    If argCnt < 0 Then EXIT_BY_ERROR
    
    'check by_col
    Call repairArray(arg(0))
    If Not IsObject(arg(0)) Then      'arg(0) is an array
        maxrowCrit = UBound(arg(0), 1)
        maxcolCrit = UBound(arg(0), 2)
    Else                              'arg(0) is a range
        maxrowCrit = arg(0).Rows.Count
        maxcolCrit = arg(0).Columns.Count
    End If
    
    If maxrowCrit > 1 And maxcolCrit > 1 Then
        EXIT_BY_ERROR
    Else
        If maxrowCrit = 1 Then
            sortByCol = True
            maxDim = maxCol
        End If
    End If
    
    'sorting directions
    crCnt = argCnt \ 2 + 1
    ReDim asc(1 To crCnt)
    
    For cr = 0 To argCnt
        If cr Mod 2 > 0 Then
            If Not IsMissing(arg(cr)) Then
                If arg(cr) = -1 Then
                    asc(cr \ 2 + 1) = -1
                End If
            End If
        End If
    Next
    
    'build criteria arrays
    ReDim crit(1 To crCnt, 1 To maxDim)
    For cr = 0 To argCnt
        If cr Mod 2 = 0 Then
            arrArg = arg(cr)
            Call repairArray(arrArg)
            If sortByCol Then
                For i = 1 To maxDim
                    crit(cr \ 2 + 1, i) = arrArg(1, i)
                Next
            Else
                For i = 1 To maxDim
                    crit(cr \ 2 + 1, i) = arrArg(i, 1)
                Next
            End If
        End If
    Next
    
    Sortby = arSort(Arr, crit, asc, maxDim, sortByCol)
End Function

Function Sortby2(rng As Variant, ParamArray arg() As Variant)
    Dim Arr As Variant
    Dim arrArg As Variant
    Dim crit As Variant
    Dim asc() As Long
    Dim i As Long
    Dim cr As Long
    Dim crCnt As Long
    Dim argCnt As Long
    Dim maxRow As Long
    Dim maxCol As Long
    Dim maxrowCrit As Long
    Dim maxcolCrit As Long
    Dim maxDim As Long
    Dim maxDim2 As Long
    Dim sortByCol As Boolean
    Dim rfCriteria As Variant
    Dim rfCriteriaUsed As Variant
    Dim rfCriteriaIndex As Long
    
    Arr = rng
    Call repairArray(Arr)
    maxRow = UBound(Arr, 1)
    maxCol = UBound(Arr, 2)
    
    If maxRow > MAXINDEXROW Or maxCol > MAXINDEXCOLUMN Then
        Sortby2 = "#OVERFLOW"
Exit Function
    End If
    
    sortByCol = False
    maxDim = maxRow
    maxDim2 = maxCol
    
    argCnt = UBound(arg)
    
    If argCnt < 0 Then EXIT_BY_ERROR
    
    'check by_col
    Call repairArray(arg(0))
    If Not IsObject(arg(0)) Then      'arg(0) is an array
        maxrowCrit = UBound(arg(0), 1)
        maxcolCrit = UBound(arg(0), 2)
    Else                              'arg(0) is a range
        maxrowCrit = arg(0).Rows.Count
        maxcolCrit = arg(0).Columns.Count
    End If
    
    If maxrowCrit > 1 And maxcolCrit > 1 Then
        EXIT_BY_ERROR
    Else
        If maxrowCrit = 1 Then
            sortByCol = True
            maxDim = maxCol
            maxDim2 = maxRow
        End If
    End If
    
    'sorting directions
    crCnt = argCnt \ 2 + 1
    ReDim asc(1 To crCnt)
    
    For cr = 0 To argCnt
        If cr Mod 2 > 0 Then
            If Not IsMissing(arg(cr)) Then
                If arg(cr) = -1 Then
                    asc(cr \ 2 + 1) = -1
                End If
            End If
        End If
    Next
    
    'build criteria arrays
    ReDim crit(1 To crCnt, 1 To maxDim)
    
    ReDim rfCriteria(1 To maxDim2 * 2)
    ReDim rfCriteriaUsed(1 To maxDim2 * 2)
    rfCriteriaIndex = 1
    
    For cr = 0 To argCnt
        If cr Mod 2 = 0 Then
            arrArg = arg(cr)
            Call repairArray(arrArg)
            If sortByCol Then
                For i = 1 To maxDim
                    crit(cr \ 2 + 1, i) = arrArg(1, i)
                Next
                rfCriteria(rfCriteriaIndex) = arg(cr).row - rng.row + 1
                rfCriteriaUsed(arg(cr).row - rng.row + 1) = True
                rfCriteriaIndex = rfCriteriaIndex + 1
            Else
                For i = 1 To maxDim
                    crit(cr \ 2 + 1, i) = arrArg(i, 1)
                Next
                rfCriteria(rfCriteriaIndex) = arg(cr).Column - rng.Column + 1
                rfCriteriaUsed(arg(cr).Column - rng.Column + 1) = True
                rfCriteriaIndex = rfCriteriaIndex + 1
            End If
        End If
    Next
        
    i = 1
    While i <= maxDim2
        If Not rfCriteriaUsed(i) Then
            rfCriteria(rfCriteriaIndex) = i
            rfCriteriaIndex = rfCriteriaIndex + 1
        End If
        i = i + 1
    Wend
    
    Sortby2 = arSort(Arr, crit, asc, maxDim, sortByCol, 2, rfCriteria)
End Function

Private Sub repairArray(ByRef Arr As Variant)
    Dim res As Variant
    Dim uBnd As Long
    Dim maxCol As Long
    Dim col As Long
    
    If Not IsObject(Arr) Then      'arr is an array, not a range
On Error GoTo UBoundError          'Workaraound for Microsofts UBound bug in case of a single row array (single column array is okay)
        uBnd = UBound(Arr, 2)
        GoTo GoOn    'no error
UBoundError:
        maxCol = UBound(Arr, 1)
        ReDim res(1 To 1, 1 To maxCol)
        For col = 1 To maxCol
            res(1, col) = Arr(col)
        Next
        Arr = res
        Resume GoOn
GoOn:
On Error GoTo 0
    End If
End Sub

Private Sub getArg(Arr As Variant, ByRef arguments() As Long)
    Dim uBnd1 As Long
    Dim uBnd2 As Long
    Dim i As Long
    
    Call repairArray(Arr)
    If Not IsObject(Arr) Then      'arr is an array
        uBnd1 = UBound(Arr, 1)
        uBnd2 = UBound(Arr, 2)
    Else                           'arr is a range
        uBnd1 = Arr.Rows.Count
        uBnd2 = Arr.Columns.Count
    End If
    
    If uBnd1 > 1 And uBnd2 > 1 Then
        EXIT_BY_ERROR
    Else
        If uBnd1 = 1 Then
            ReDim arguments(1 To uBnd2)
            For i = 1 To uBnd2
                arguments(i) = Arr(1, i)
            Next
        Else
            ReDim arguments(1 To uBnd1)
            For i = 1 To uBnd1
                arguments(i) = Arr(i, 1)
            Next
        End If
    End If
End Sub

Private Sub EXIT_BY_ERROR()
    Dim errorArr() As Long
    errorArr(0) = 1   'exit by #VALUE error
End Sub

Private Function arSort(Arr As Variant, crit As Variant, asc As Variant, maxDim As Long, sortByCol As Boolean, _
                      Optional mode As Long = 1, Optional rfCriteria As Variant = Null)

    Dim sortArr() As Variant
    Dim sortString() As String
    Dim rank() As Variant
    Dim rf As Variant
    Dim crCnt As Long
    Dim i As Long
    Dim ind As Long
    Dim row As Long
    Dim col As Long
    Dim cr As Long
    
    ReDim sortString(maxDim)
    ReDim sortArr(maxDim)
    ReDim rank(maxDim)
    ReDim rf(maxDim)
    
    crCnt = UBound(crit, 1)
    
    'criterion 1
    For i = 1 To maxDim
        rf(i) = i
    Next
    For ind = 1 To maxDim
        sortArr(ind) = crit(1, ind)
    Next
    If asc(1) = -1 Then
        Call arQuicksortDesc(sortArr, 1, maxDim, rf)
    Else
        Call arQuicksort(sortArr, 1, maxDim, rf)
    End If
    
    If crCnt > 1 Then
        'ranking 1
        i = 1
        rank(rf(1)) = 1
        For ind = 2 To maxDim
            If crit(1, rf(ind)) <> crit(1, rf(ind - 1)) Then
                i = i + 1
            End If
            rank(rf(ind)) = i
        Next
        For row = 1 To maxDim
            sortString(row) = Format(rank(row), FORMATSTRING)
        Next
        
        For cr = 2 To crCnt
            'criterion
            For i = 1 To maxDim
                rf(i) = i
            Next
            For ind = 1 To maxDim
                sortArr(ind) = crit(cr, ind)
            Next
            If asc(cr) = -1 Then
                Call arQuicksortDesc(sortArr, 1, maxDim, rf)
            Else
                Call arQuicksort(sortArr, 1, maxDim, rf)
            End If
            'ranking
            i = 1
            rank(rf(1)) = 1
            For ind = 2 To maxDim
                If crit(cr, rf(ind)) <> crit(cr, rf(ind - 1)) Then
                    i = i + 1
                End If
                rank(rf(ind)) = i
            Next
            For row = 1 To maxDim
                sortString(row) = sortString(row) & Format(rank(row), FORMATSTRING)
            Next
        Next
        
        'final sorting
        For i = 1 To maxDim
            rf(i) = i
        Next
        For row = 1 To maxDim
            sortArr(row) = sortString(row)
        Next
        Call arQuicksort(sortArr, 1, maxDim, rf)
    End If
    
    'prepare the return array
    sortArr = Arr
    If mode = 2 Then
        If sortByCol Then
            For row = 1 To UBound(Arr, 1)
                For col = 1 To UBound(Arr, 2)
                    If Arr(row, rf(col)) = "" Then
                        sortArr(row, col) = ""
                    Else
                        sortArr(row, col) = Arr(rfCriteria(row), rf(col))
                    End If
                Next
            Next
        Else
            For row = 1 To UBound(Arr, 1)
                For col = 1 To UBound(Arr, 2)
                    If Arr(rf(row), col) = "" Then
                        sortArr(row, col) = ""
                    Else
                        sortArr(row, col) = Arr(rf(row), rfCriteria(col))
                    End If
                Next
            Next
        End If
    Else
        If sortByCol Then
            For row = 1 To UBound(Arr, 1)
                For col = 1 To UBound(Arr, 2)
                    If Arr(row, rf(col)) = "" Then
                        sortArr(row, col) = ""
                    Else
                        sortArr(row, col) = Arr(row, rf(col))
                    End If
                Next
            Next
        Else
            For row = 1 To UBound(Arr, 1)
                For col = 1 To UBound(Arr, 2)
                    If Arr(rf(row), col) = "" Then
                        sortArr(row, col) = ""
                    Else
                        sortArr(row, col) = Arr(rf(row), col)
                    End If
                Next
            Next
        End If
    End If
    
    arSort = sortArr
End Function

Private Function arQuicksort(Arr As Variant, arrLeft As Long, arrRight As Long, rf As Variant)
Dim pivot As Variant
Dim tmp As Variant
Dim left As Long
Dim right As Long
 
left = arrLeft
right = arrRight
pivot = Arr((arrLeft + arrRight) \ 2)
 
While (left <= right)
   While ((Arr(left) < pivot And Arr(left) <> "") Or (Arr(left) <> "" And pivot = "") And left < arrRight)
      left = left + 1
   Wend
  
   While ((pivot < Arr(right) And pivot <> "") Or (pivot <> "" And Arr(right) = "") And arrLeft < right)
      right = right - 1
   Wend
 
   If (left <= right) Then
      tmp = Arr(left)
      Arr(left) = Arr(right)
      Arr(right) = tmp
      tmp = rf(left)
      rf(left) = rf(right)
      rf(right) = tmp
      left = left + 1
      right = right - 1
   End If
Wend
 
  If (arrLeft < right) Then arQuicksort Arr, arrLeft, right, rf
  If (left < arrRight) Then arQuicksort Arr, left, arrRight, rf
End Function

Private Function arQuicksortDesc(Arr As Variant, arrLeft As Long, arrRight As Long, rf As Variant)
Dim pivot As Variant
Dim tmp As Variant
Dim left As Long
Dim right As Long
 
left = arrLeft
right = arrRight
pivot = Arr((arrLeft + arrRight) \ 2)
 
While (left <= right)
   While (Arr(left) > pivot Or (Arr(left) <> "" And pivot = "") And left < arrRight)
      left = left + 1
   Wend
  
   While (pivot > Arr(right) Or (pivot <> "" And Arr(right) = "") And arrLeft < right)
      right = right - 1
   Wend
 
   If (left <= right) Then
      tmp = Arr(left)
      Arr(left) = Arr(right)
      Arr(right) = tmp
      tmp = rf(left)
      rf(left) = rf(right)
      rf(right) = tmp
      left = left + 1
      right = right - 1
   End If
Wend
 
  If (arrLeft < right) Then arQuicksortDesc Arr, arrLeft, right, rf
  If (left < arrRight) Then arQuicksortDesc Arr, left, arrRight, rf
End Function
Function Randarray(ParamArray arg() As Variant)
    Dim argCnt As Long
    Dim arguments() As Long
    Dim result() As Double
    Dim i As Long
    Dim k As Long
    
    'getting arguments
    argCnt = UBound(arg) + 1
    ReDim arguments(1 To 5)
    
    arguments(1) = 1
    arguments(2) = 1
    arguments(3) = 0
    arguments(4) = 1
    arguments(5) = False
    
    If argCnt > 0 Then
        For i = 1 To argCnt
            If Not IsMissing(arg(i - 1)) Then
                arguments(i) = arg(i - 1)
            End If
        Next
    End If
    
    If arguments(3) >= arguments(4) Then arguments(0) = 1  'exit by #VALUE error
    
    'preparing result array
    ReDim result(1 To arguments(1), 1 To arguments(2))
    
    Randomize
    For i = 1 To arguments(1)
        For k = 1 To arguments(2)
            If arguments(5) Then
                result(i, k) = Int((arguments(4) - arguments(3) + 1) * Rnd + arguments(3))
            Else
                result(i, k) = (arguments(4) - arguments(3)) * Rnd + arguments(3)
            End If
        Next
    Next
    
    Randarray = result
End Function

Function Sequence(ParamArray arg() As Variant)
    Dim argCnt As Long
    Dim arguments() As Long
    Dim result() As Long
    Dim i As Long
    Dim k As Long
    Dim res As Long
    
    'getting arguments
    argCnt = UBound(arg) + 1
    ReDim arguments(1 To 4)
    
    If argCnt < 1 Then
        For i = 1 To 4
            arguments(i) = 1
        Next
    Else
        For i = 1 To argCnt
            If IsMissing(arg(i - 1)) Then
                arguments(i) = 1
            Else
                arguments(i) = arg(i - 1)
            End If
        Next
        For i = argCnt + 1 To 4
            arguments(i) = 1
        Next
    End If
    
    'preparing result array
    ReDim result(1 To arguments(1), 1 To arguments(2))
    res = arguments(3)
    For i = 1 To arguments(1)
        For k = 1 To arguments(2)
            result(i, k) = res
            res = res + arguments(4)
        Next
    Next
    
    Sequence = result
End Function


