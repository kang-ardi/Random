Function BinSearchLookupAsc(Arr As Variant, crit As Variant, mMode As Long)
    Dim low As Long
    Dim upp As Long
    Dim mid As Long
    Dim maxLoops As Long
    Dim loops As Long
    Dim retInd As Long
    
    Dim indArr As Variant
    Dim maxInd As Long
    Dim critCnt As Long
    Dim critInd As Long

    maxInd = UBound(Arr, 1)
    critCnt = UBound(crit, 1)
    ReDim indArr(1 To critCnt)
    
    For critInd = 1 To critCnt
        If crit(critInd) < Arr(1, 1) Then
            If mMode = 1 Then
                retInd = 1
            Else   'mMode -1, 0, 2
                retInd = -1
            End If
        Else
            If crit(critInd) > Arr(maxInd, 1) Then
                If mMode = -1 Then
                    retInd = maxInd
                Else   'mMode 1, 0, 2
                    retInd = -1
                End If
            Else   'binary search
                low = 1
                upp = maxInd
                maxLoops = Int(Log(upp) / Log(2)) + 2
                
                loops = 0
                While low < upp And loops <= maxLoops
                    mid = (low + upp) \ 2
                    If crit(critInd) > Arr(mid, 1) Then
                        low = mid + 1
                    Else
                        upp = mid
                    End If
                    loops = loops + 1
                Wend
                
                If loops > maxLoops Then
                    retInd = -1
                ElseIf crit(critInd) = Arr(low, 1) Then
                    retInd = low
                ElseIf mMode = 1 Then
                    retInd = low
                ElseIf mMode = -1 Then
                    retInd = low - 1
                Else
                    retInd = -1
                End If
            End If
        End If
        indArr(critInd) = retInd
    Next
    
    BinSearchLookupAsc = indArr
End Function

Function BinSearchLookupDesc(Arr As Variant, crit As Variant, mMode As Long)
