                    retInd = low - 1
                ElseIf mMode = -1 Then
                    retInd = low
                Else
                    retInd = -1
                End If
            End If
        End If
        indArr(critInd) = retInd
    Next
    
    BinSearchLookupDesc = indArr
End Function

Function XMatch(ParamArray arg() As Variant)
'(crit, lookArr, match_mode, search_mode)

    Dim crit As Variant
    Dim critArr As Variant
    Dim lookArr As Variant
    Dim indArr As Variant
    Dim ret As Variant
    Dim maxrowCrit As Long
    Dim maxcolCrit As Long
    Dim mMode As Long
    Dim sMode As Long
    Dim argCnt As Long
    Dim byRow As Boolean
    Dim maxrowLook As Long
    Dim maxcolLook As Long
    Dim row As Long
    Dim col As Long
    Dim ind As Long
    
    argCnt = UBound(arg)
    
    If argCnt < 1 Then EXIT_BY_ERROR   '****
    
    'argument 1 (crit)
    If IsMissing(arg(0)) Then
        arg(0) = ""
    End If
    
    If Not IsArray(arg(0)) Then
        ReDim crit(1 To 1)
        crit(1) = arg(0)
    Else
        critArr = arg(0)
        Call repairArray(critArr)
        maxrowCrit = UBound(critArr, 1)
        maxcolCrit = UBound(critArr, 2)
        If maxrowCrit > 1 And maxcolCrit > 1 Then EXIT_BY_ERROR   '****
        If maxrowCrit > 1 Then
            ReDim crit(1 To maxrowCrit)
            For row = 1 To maxrowCrit
                crit(row) = critArr(row, 1)
            Next
        Else
            ReDim crit(1 To maxcolCrit)
            For col = 1 To maxcolCrit
                crit(col) = critArr(1, col)
            Next
        End If
    End If
    
    'argument 2 (lookArr)
    If Not IsArray(arg(1)) Then EXIT_BY_ERROR   '****
    lookArr = arg(1)
    Call repairArray(lookArr)
    maxrowLook = UBound(lookArr, 1)
    maxcolLook = UBound(lookArr, 2)
    If maxrowLook > 1 And maxcolLook > 1 Then EXIT_BY_ERROR   '****
    byRow = (maxcolLook > 1)
    
    'argument 3 (mMode)
    If argCnt >= 2 Then
        If IsMissing(arg(2)) Then
            mMode = 0
        Else
            mMode = arg(2)
        End If
    Else
        mMode = 0
    End If

    'argument 4 (sMode)
    If argCnt >= 3 Then
        If IsMissing(arg(3)) Then
            sMode = 1
        Else
            sMode = arg(3)
        End If
    Else
        sMode = 1
    End If
    
    'Calculate XMatch
    indArr = lookupIndex(crit, lookArr, byRow, mMode, sMode)
    
    'Prepare the Return array
    For ind = 1 To UBound(indArr, 1)
        If indArr(ind) = -1 Then
            indArr(ind) = "#NV"
        End If
    Next
    
    If byRow Then
        ReDim ret(1 To 1, 1 To UBound(indArr, 1))
        For col = 1 To UBound(indArr, 1)
            ret(1, col) = indArr(col)
        Next
    Else
        ReDim ret(1 To UBound(indArr, 1), 1 To 1)
        For row = 1 To UBound(indArr, 1)
            ret(row, 1) = indArr(row)
        Next
    End If
    
    XMatch = ret
End Function

Function XLookup2(ParamArray arg() As Variant)
'(crit1, lookArr1, retArr, if_not_found, match_mode, search_mode, crit2, lookArr2, crit3, lookArr3, ...)

    Dim critArr As Variant
    Dim retArr As Variant
    Dim lkArr As Variant
    Dim Arr As Variant
    Dim lookArr As Variant
    Dim indArr As Variant
    Dim notFnd As Variant
    Dim mMode As Long
    Dim sMode As Long
    Dim argCnt As Long
    Dim critCnt As Long
    Dim argNr As Long
    Dim critNr As Long
    Dim maxInd As Long
    Dim byRow As Boolean
    Dim maxrowLook As Long
    Dim maxcolLook As Long
    Dim maxrowRet As Long
    Dim maxcolRet As Long
    Dim ind As Long
    Dim row As Long
    Dim col As Long
    Dim ret As Variant
    
    argCnt = UBound(arg)
    
    If argCnt < 2 Then EXIT_BY_ERROR   '****
    
    If argCnt < 6 Then
        critCnt = 1
    Else
        critCnt = (argCnt - 4) \ 2 + 1
    End If
    
    ReDim critArr(1 To critCnt)
    ReDim lookArr(1 To critCnt)
    
    'argument 1 (crit1)
    If IsMissing(arg(0)) Then
        critArr(1) = ""
    Else
        critArr(1) = arg(0)
    End If
    
    'argument 2 (lookArr1)
    If Not IsArray(arg(1)) Then EXIT_BY_ERROR   '****
    lkArr = arg(1)
    Call repairArray(lkArr)
    maxrowLook = UBound(lkArr, 1)
    maxcolLook = UBound(lkArr, 2)
    If maxrowLook > 1 And maxcolLook > 1 Then EXIT_BY_ERROR   '****
    byRow = (maxcolLook > 1)
    
    If byRow Then
        maxInd = maxcolLook
    Else
        maxInd = maxrowLook
    End If

    If byRow Then
        ReDim Arr(1 To maxInd, 1 To 1)
        For ind = 1 To maxInd
            Arr(ind, 1) = lkArr(1, ind)
        Next
        lookArr(1) = Arr
    Else
        lookArr(1) = lkArr
    End If
    
    'argument 3 (retArr)
    If Not IsArray(arg(2)) Then EXIT_BY_ERROR   '****
    If IsObject(arg(2)) Then
        Set retArr = arg(2)
        maxrowRet = retArr.Rows.Count
        maxcolRet = retArr.Columns.Count
    Else
        retArr = arg(2)
        Call repairArray(retArr)
        maxrowRet = UBound(retArr, 1)
        maxcolRet = UBound(retArr, 2)
    End If
    
    If byRow And (maxcolLook <> maxcolRet) Then EXIT_BY_ERROR   '****
    If Not byRow And (maxrowLook <> maxrowRet) Then EXIT_BY_ERROR   '****
    
    'argument 4 (notFnd)
    If argCnt >= 3 Then
        If IsMissing(arg(3)) Then
            notFnd = CVErr(xlErrNA)
        Else
            notFnd = arg(3)
        End If
    Else
        notFnd = CVErr(xlErrNA)
    End If

    'argument 5 (mMode)
    If argCnt >= 4 Then
        If IsMissing(arg(4)) Then
            mMode = 0
        Else
            mMode = arg(4)
        End If
    Else
        mMode = 0
    End If
    If mMode <> 0 And mMode <> 2 Then EXIT_BY_ERROR   '****

    'argument 6 (sMode)
    If argCnt >= 5 Then
        If IsMissing(arg(5)) Then
            sMode = 1
        Else
            sMode = arg(5)
        End If
    Else
        sMode = 1
    End If
    If sMode <> 1 And sMode <> 2 And sMode <> -1 And sMode <> -2 Then EXIT_BY_ERROR   '****
    
    'more lookup criteria
    If argCnt >= 6 Then
        For argNr = 6 To argCnt
            critNr = (argNr - 4) \ 2 + 1
            If argNr Mod 2 = 0 Then   'lookup criterion
                If IsMissing(arg(argNr)) Then
                    critArr(critNr) = ""
                Else
                    critArr(critNr) = arg(argNr)
                End If
            Else       'lookup array
                If Not IsArray(arg(argNr)) Then EXIT_BY_ERROR   '****
                lkArr = arg(argNr)
                Call repairArray(lkArr)
                maxrowLook = UBound(lkArr, 1)
                maxcolLook = UBound(lkArr, 2)
                If maxrowLook > 1 And maxcolLook > 1 Then EXIT_BY_ERROR   '****
                
                If byRow Then
                    ReDim Arr(1 To maxInd, 1 To 1)
                    For ind = 1 To maxInd
                        Arr(ind, 1) = lkArr(1, ind)
                    Next
                    lookArr(critNr) = Arr
                Else
                    lookArr(critNr) = lkArr
                End If
            End If
        Next
    End If
    
    'calculating XLOOKUP
    If sMode = 1 Then
        indArr = SeqLookupAsc2Break(lookArr, critArr, mMode)
    ElseIf sMode = -1 Then
        indArr = SeqLookupDesc2Break(lookArr, critArr, mMode)
    ElseIf sMode = 2 Then
        indArr = SeqLookupAsc2All(lookArr, critArr, mMode)
    Else    'sMode = -2
        indArr = SeqLookupDesc2All(lookArr, critArr, mMode)
    End If
    
    'preparing return array
    If indArr(1) < 1 Then
        ret = notFnd
    Else
        If sMode = 2 Or sMode = -2 Then
            ReDim ret(1 To maxrowRet, 1 To maxcolRet)
            If byRow Then
                For col = 1 To maxcolRet
                    For row = 1 To maxrowRet
                        If indArr(row) >= 1 Then
                            If retArr(row, indArr(col)) = "" Then
                                ret(row, col) = ""
                            Else
                                ret(row, col) = retArr(row, indArr(col))
                            End If
                        Else
                            ret(row, col) = ""
                        End If
                    Next
                Next
            Else
                For row = 1 To maxrowRet
                    For col = 1 To maxcolRet
                        If indArr(row) >= 1 Then
                            If retArr(indArr(row), col) = "" Then
                                ret(row, col) = ""
                            Else
                                ret(row, col) = retArr(indArr(row), col)
                            End If
                        Else
                            ret(row, col) = ""
                        End If
                    Next
                Next
            End If
        Else
            If byRow Then
                If IsObject(retArr) Then
                    Set ret = Range(retArr.Cells(1, indArr(1)), retArr.Cells(maxrowRet, indArr(1)))
                Else
                    ReDim ret(1 To maxrowRet, 1 To 1)
                    For row = 1 To maxrowRet
                        If retArr(row, indArr(1)) = "" Then
                            ret(row, 1) = ""
                        Else
                            ret(row, 1) = retArr(row, indArr(1))
                        End If
                    Next
                End If
            Else
                If IsObject(retArr) Then
                    Set ret = Range(retArr.Cells(indArr(1), 1), retArr.Cells(indArr(1), maxcolRet))
                Else
                    ReDim ret(1 To 1, 1 To maxcolRet)
                    For col = 1 To maxcolRet
                        If retArr(indArr(1), col) = "" Then
                            ret(1, col) = ""
                        Else
                            ret(1, col) = retArr(indArr(1), col)
                        End If
                    Next
                End If
            End If
        End If
    End If
    
    If IsObject(ret) Then
        Set XLookup2 = ret
    Else
        XLookup2 = ret
    End If
End Function

Function SeqLookupAsc2Break(lookArr As Variant, critArr As Variant, mMode As Long)
    Dim maxInd As Long
    Dim ind As Long
    Dim critCnt As Long
    Dim critNr As Long
    Dim gefunden As Boolean
    Dim indArr As Variant

    maxInd = UBound(lookArr(1), 1)
    critCnt = UBound(critArr, 1)
    ReDim indArr(maxInd)

    If mMode = 0 Then    'mMode = 0
        ind = 1
        While ind <= maxInd
            gefunden = True
            For critNr = 1 To critCnt
                If (lookArr(critNr)(ind, 1) <> critArr(critNr)) And (critArr(critNr) <> "") Then
                    gefunden = False
                    Exit For
                End If
            Next
            If gefunden Then
                indArr(1) = ind
                ind = maxInd   'Break
            End If
            ind = ind + 1
        Wend
    Else  'mMode = 2
        ind = 1
        While ind <= maxInd
            gefunden = True
            For critNr = 1 To critCnt
                If (Not (lookArr(critNr)(ind, 1) Like critArr(critNr))) And (critArr(critNr) <> "") Then
                    gefunden = False
                    Exit For
                End If
            Next
            If gefunden Then
                indArr(1) = ind
                ind = maxInd   'Break
