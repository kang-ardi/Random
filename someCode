Option Explicit
Option Compare Text

Const MAXINDEXROW = 1048576
Const MAXINDEXCOLUMN = 16384
Const FORMATSTRING = "0000000"

Function myFilter(rng As Variant, filter As Variant, Optional isEmpty As String = "")
    Dim Arr As Variant
    Dim result As Variant
    Dim crit As Variant
    Dim maxRow As Long
    Dim maxCol As Long
    Dim maxRowArg As Long
    Dim maxColArg As Long
    Dim row As Long
    Dim col As Long
    Dim k As Long
    Dim ind As Long
    Dim maxDim As Long
    Dim filterByCol As Boolean
    
    Arr = rng
    Call repairArray(Arr)
    maxRow = UBound(Arr, 1)
    maxCol = UBound(Arr, 2)
    
    If maxRow > MAXINDEXROW Or maxCol > MAXINDEXCOLUMN Then
        myFilter = "#OVERFLOW"
Exit Function
    End If
    
    filterByCol = False
    maxDim = maxRow
    
    Call repairArray(filter)
    If Not IsObject(filter) Then      'filter is an array
        maxRowArg = UBound(filter, 1)
        maxColArg = UBound(filter, 2)
    Else                              'filter is a range
        maxRowArg = filter.Rows.Count
        maxColArg = filter.Columns.Count
    End If
    
    If maxRowArg > 1 And maxColArg > 1 Then
        myFilter = "#ERROR"
Exit Function
    Else
        If maxRowArg = 1 Then
            filterByCol = True
            maxDim = maxCol
        End If
    End If

    ReDim crit(1 To maxDim)
    
    If filterByCol Then
        For k = 1 To maxDim
            crit(k) = filter(1, k)
        Next
    Else
        For k = 1 To maxDim
            crit(k) = filter(k, 1)
        Next
    End If
    
    'filter the data
    ReDim result(1 To maxRow, 1 To maxCol)
    If filterByCol Then
        ind = 1
        For col = 1 To maxCol
            If crit(col) Then
                For row = 1 To maxRow
                    If Arr(row, col) = "" Then
                        result(row, ind) = ""
                    Else
                        result(row, ind) = Arr(row, col)
                    End If
                Next
                ind = ind + 1
            End If
        Next
        For col = ind To maxCol
            For row = 1 To maxRow
                result(row, col) = ""
            Next
        Next
    Else
        ind = 1
        For row = 1 To maxRow
            If crit(row) Then
                For col = 1 To maxCol
                    If Arr(row, col) = "" Then
                        result(ind, col) = ""
                    Else
                        result(ind, col) = Arr(row, col)
                    End If
                Next
                ind = ind + 1
            End If
        Next
        For row = ind To maxRow
            For col = 1 To maxCol
                result(row, col) = ""
            Next
        Next
    End If
    If ind = 1 Then
        result(1, 1) = isEmpty
    End If
    
    myFilter = result
End Function

Function myUnique(rng As Variant, Optional byCol As Boolean = False, Optional exactOnce As Boolean = False)
    Dim maxRow As Long
    Dim maxCol As Long
    Dim ind As Long
    Dim k As Long
    Dim cnt As Long
    Dim Arr As Variant
    Dim res As Variant
    Dim result As Variant
    Dim found As Boolean
    Dim equal As Boolean
    Dim leer As Boolean
    Dim maxDim As Long
    Dim row As Long
    Dim col As Long
    Dim cntEqual As Long
    
    Arr = rng
    Call repairArray(Arr)
    maxRow = UBound(Arr, 1)
    maxCol = UBound(Arr, 2)
    
    If maxRow > MAXINDEXROW Or maxCol > MAXINDEXCOLUMN Then
        myUnique = "#OVERFLOW"
Exit Function
    End If
    
    ReDim result(1 To maxRow, 1 To maxCol)
    
    cnt = 0
    
    If exactOnce Then
        If byCol Then   'data record is a column
            For col = 1 To maxCol
                cntEqual = 0
                For k = 1 To maxCol
                    equal = True
                    For row = 1 To maxRow
                        If Arr(row, col) <> Arr(row, k) Then
                            equal = False
                            Exit For
                        End If
                    Next
                    If equal Then
                        cntEqual = cntEqual + 1
                    End If
                    If cntEqual > 1 Then Exit For
                Next
                If cntEqual = 1 Then
                    leer = True
                    For row = 1 To maxRow
                        If Arr(row, col) <> "" Then
                            leer = False
                            Exit For
                        End If
                    Next
                    If Not leer Then
                        cnt = cnt + 1
                        For row = 1 To maxRow
                            If Arr(row, col) = "" Then
                                result(row, cnt) = ""
                            Else
                                result(row, cnt) = Arr(row, col)
                            End If
                        Next
                    End If
                End If
            Next
        Else     'data record is a row
            For row = 1 To maxRow
                cntEqual = 0
                For k = 1 To maxRow
                    equal = True
                    For col = 1 To maxCol
                        If Arr(row, col) <> Arr(k, col) Then
                            equal = False
                            Exit For
                        End If
                    Next
                    If equal Then
                        cntEqual = cntEqual + 1
                    End If
                    If cntEqual > 1 Then Exit For
                Next
                If cntEqual = 1 Then
                    leer = True
                    For col = 1 To maxCol
                        If Arr(row, col) <> "" Then
                            leer = False
                            Exit For
                        End If
                    Next
                    If Not leer Then
                        cnt = cnt + 1
                        For col = 1 To maxCol
                            If Arr(row, col) = "" Then
                                result(cnt, col) = ""
                            Else
                                result(cnt, col) = Arr(row, col)
                            End If
                        Next
                    End If
                End If
            Next
        End If
    Else    'not exactOnce
        If byCol Then   'data record is a column
            For col = 1 To maxCol
                found = False
                For k = 1 To cnt
                    equal = True
                    For row = 1 To maxRow
                        If Arr(row, col) <> result(row, k) Then
                            equal = False
                            Exit For
                        End If
                    Next
                    If equal Then
                        found = True
                        Exit For
                    End If
                Next
                If Not found Then
                    leer = True
                    For row = 1 To maxRow
                        If Arr(row, col) <> "" Then
                            leer = False
                            Exit For
                        End If
                    Next
                    If Not leer Then
                        cnt = cnt + 1
                        For row = 1 To maxRow
                            If Arr(row, col) = "" Then
                                result(row, cnt) = ""
                            Else
                                result(row, cnt) = Arr(row, col)
                            End If
                        Next
                    End If
                End If
            Next
        Else     'data record is a row
            For row = 1 To maxRow
                found = False
                For k = 1 To cnt
                    equal = True
                    For col = 1 To maxCol
                        If Arr(row, col) <> result(k, col) Then
                            equal = False
                            Exit For
                        End If
                    Next
                    If equal Then
                        found = True
                        Exit For
                    End If
                Next
                If Not found Then
                    leer = True
                    For col = 1 To maxCol
                        If Arr(row, col) <> "" Then
                            leer = False
                            Exit For
                        End If
                    Next
                    If Not leer Then
                        cnt = cnt + 1
                        For col = 1 To maxCol
                            If Arr(row, col) = "" Then
                                result(cnt, col) = ""
                            Else
                                result(cnt, col) = Arr(row, col)
                            End If
                        Next
                    End If
                End If
            Next
        End If
    End If
    
    cnt = cnt + 1
    
    If byCol Then
        For col = cnt To maxCol
            For row = 1 To maxRow
                result(row, col) = ""
            Next
        Next
    Else
        For row = cnt To maxRow
            For col = 1 To maxCol
                result(row, col) = ""
            Next
        Next
    End If
    
    myUnique = result
End Function


Option Explicit
Option Compare Text

Const MAXINDEXROW = 1048576
Const MAXINDEXCOLUMN = 16384
Const FORMATSTRING = "0000000"

Function XLookup(ParamArray arg() As Variant)
'(crit, lookArr, retArr, if_not_found, match_mode, search_mode)

    Dim crit As Variant
    Dim critArr As Variant
    Dim retArr As Variant
    Dim lookArr As Variant
    Dim indArr As Variant
    Dim ret As Variant
    Dim notFnd As String
    Dim mMode As Long
    Dim sMode As Long
    Dim argCnt As Long
    Dim byRow As Boolean
    Dim maxrowCrit As Long
    Dim maxcolCrit As Long
    Dim maxrowLook As Long
    Dim maxcolLook As Long
    Dim maxrowRet As Long
    Dim maxcolRet As Long
    Dim ind As Long
    Dim row As Long
    Dim col As Long
    Dim critInd As Long
    
    argCnt = UBound(arg)
    
    If (argCnt < 2) Or (argCnt > 5) Then EXIT_BY_ERROR  '****
    
    'argument 1 (crit)
    If IsMissing(arg(0)) Then
        arg(0) = ""
    End If
    
    If Not IsArray(arg(0)) Then
        ReDim crit(1 To 1)
        crit(1) = arg(0)
    Else
        critArr = arg(0)
        Call repairArray(critArr)
        maxrowCrit = UBound(critArr, 1)
        maxcolCrit = UBound(critArr, 2)
        If maxrowCrit > 1 And maxcolCrit > 1 Then EXIT_BY_ERROR   '****
        If maxrowCrit > 1 Then
            ReDim crit(1 To maxrowCrit)
            For row = 1 To maxrowCrit
                crit(row) = critArr(row, 1)
            Next
        Else
            ReDim crit(1 To maxcolCrit)
            For col = 1 To maxcolCrit
                crit(col) = critArr(1, col)
            Next
        End If
    End If
    
    'argument 2 (lookArr)
    If Not IsArray(arg(1)) Then EXIT_BY_ERROR   '****
    lookArr = arg(1)
    Call repairArray(lookArr)
    maxrowLook = UBound(lookArr, 1)
    maxcolLook = UBound(lookArr, 2)
    If maxrowLook > 1 And maxcolLook > 1 Then EXIT_BY_ERROR   '****
    byRow = (maxcolLook > 1)
    
    'argument 3 (retArr)
    If Not IsArray(arg(2)) Then EXIT_BY_ERROR   '****
    If IsObject(arg(2)) Then
        Set retArr = arg(2)
        maxrowRet = retArr.Rows.Count
        maxcolRet = retArr.Columns.Count
    Else
        retArr = arg(2)
        Call repairArray(retArr)
        maxrowRet = UBound(retArr, 1)
        maxcolRet = UBound(retArr, 2)
    End If
    
    If byRow And (maxcolLook <> maxcolRet) Then EXIT_BY_ERROR   '****
    If Not byRow And (maxrowLook <> maxrowRet) Then EXIT_BY_ERROR   '****
    
    'argument 4 (notFnd)
    If argCnt >= 3 Then
        If IsMissing(arg(3)) Then
            notFnd = "#N/A"
        Else
            notFnd = arg(3)
        End If
    Else
        notFnd = "#N/A"
    End If

    'argument 5 (mMode)
    If argCnt >= 4 Then
        If IsMissing(arg(4)) Then
            mMode = 0
        Else
            mMode = arg(4)
        End If
    Else
        mMode = 0
    End If
    If mMode <> 0 And mMode <> 1 And mMode <> -1 And mMode <> 2 Then EXIT_BY_ERROR   '****

    'argument 6 (sMode)
    If argCnt >= 5 Then
        If IsMissing(arg(5)) Then
            sMode = 1
        Else
            sMode = arg(5)
        End If
    Else
        sMode = 1
    End If
    If sMode <> 1 And sMode <> 2 And sMode <> -1 And sMode <> -2 Then EXIT_BY_ERROR   '****
    
    'calculating XLOOKUP
    indArr = lookupIndex(crit, lookArr, byRow, mMode, sMode)
    
    'return the searching result
    If UBound(indArr, 1) < 2 Then
        ind = indArr(1)
        If ind = -1 Then
            ret = notFnd
        Else
            If byRow Then
                If IsObject(retArr) Then
                    Set ret = Range(retArr.Cells(1, ind), retArr.Cells(maxrowRet, ind))
                Else
                    ReDim ret(1 To maxrowRet, 1 To 1)
                    For row = 1 To maxrowRet
                        ret(row, 1) = retArr(row, ind)
                    Next
                End If
            Else
                If IsObject(retArr) Then
                    Set ret = Range(retArr.Cells(ind, 1), retArr.Cells(ind, maxcolRet))
                Else
                    ReDim ret(1 To 1, 1 To maxcolRet)
                    For col = 1 To maxcolRet
                        ret(1, col) = retArr(ind, col)
                    Next
                End If
            End If
        End If
        
        If IsObject(ret) Then
            Set XLookup = ret
        Else
            XLookup = ret
        End If
    Else   'search criterium is an array
        If byRow Then
            ReDim ret(1 To maxrowRet, 1 To UBound(indArr, 1))
            For col = 1 To UBound(indArr, 1)
                If indArr(col) = -1 Then
                    ret(1, col) = notFnd
                    For row = 2 To maxrowRet
                        ret(row, col) = ""
                    Next
                Else
                    For row = 1 To maxrowRet
                        ret(row, col) = retArr(row, indArr(col))
                    Next
                End If
            Next
        Else
            ReDim ret(1 To UBound(indArr, 1), 1 To maxcolRet)
            For row = 1 To UBound(indArr, 1)
                If indArr(row) = -1 Then
                    ret(row, 1) = notFnd
                    For col = 2 To maxcolRet
                        ret(row, col) = ""
                    Next
                Else
                    For col = 1 To maxcolRet
                        ret(row, col) = retArr(indArr(row), col)
                    Next
                End If
            Next
        End If
              
        XLookup = ret
    End If
End Function

Private Function lookupIndex(crit As Variant, lookArr As Variant, byRow As Boolean, mMode As Long, sMode As Long) As Variant
    Dim Arr As Variant
    Dim indArr As Variant
    Dim maxInd As Long
    Dim ind As Long
    
    If byRow Then
        maxInd = UBound(lookArr, 2)
        ReDim Arr(1 To maxInd, 1 To 1)
        For ind = 1 To maxInd
            Arr(ind, 1) = lookArr(1, ind)
        Next
    Else
        Arr = lookArr
    End If
    
    ReDim indArr(1 To UBound(crit, 1))
    
    'lookup
    If sMode = 1 Then
        If mMode = 0 Then
            indArr = SeqLookupExactAsc(Arr, crit, mMode)   'sMode = 1, mMode = 0
        Else
            indArr = SeqLookupAsc(Arr, crit, mMode)           'sMode = 1, mMode = 1, -1, 2
        End If
    ElseIf sMode = -1 Then
        If mMode = 0 Then
            indArr = SeqLookupExactDesc(Arr, crit, mMode)  'sMode = -1, mMode = 0
        Else
            indArr = SeqLookupDesc(Arr, crit, mMode)           'sMode = -1, mMode = 1, -1, 2
        End If
    ElseIf sMode = 2 Then
        If mMode = 2 Then
            indArr = SeqLookupAsc(Arr, crit, mMode)        'sMode = 2, mMode = 2
        Else
            indArr = BinSearchLookupAsc(Arr, crit, mMode)      'sMode = 2, mMode = 0, 1, -1
        End If
    Else   'sMode = -2
        If mMode = 2 Then
            indArr = SeqLookupDesc(Arr, crit, mMode)       'sMode = -2, mMode = 2
        Else
            indArr = BinSearchLookupDesc(Arr, crit, mMode)     'sMode = -2, mMode = 0, 1, -1
        End If
    End If
    
    lookupIndex = indArr
End Function

Function SeqLookupExactAsc(Arr As Variant, crit As Variant, mMode As Long)
'A little bit faster than SeqLookupAsc
    Dim indArr As Variant
    Dim maxInd As Long
    Dim critCnt As Long
    Dim critInd As Long
    Dim ind As Long
    Dim gefunden As Boolean

    maxInd = UBound(Arr, 1)
    critCnt = UBound(crit, 1)
    ReDim indArr(1 To critCnt)

    For critInd = 1 To critCnt
        ind = 1
        gefunden = False
        While ind <= maxInd And Not gefunden
            If Arr(ind, 1) <> crit(critInd) Then
                ind = ind + 1
            Else
                gefunden = True
            End If
        Wend
        If Not gefunden Then
            indArr(critInd) = -1
        Else
            indArr(critInd) = ind
        End If
    Next

    SeqLookupExactAsc = indArr
End Function

Function SeqLookupExactDesc(Arr As Variant, crit As Variant, mMode As Long)
'A little bit faster than SeqLookupDesc
    Dim indArr As Variant
    Dim maxInd As Long
    Dim critCnt As Long
    Dim critInd As Long
    Dim ind As Long
    Dim gefunden As Boolean

    maxInd = UBound(Arr, 1)
    critCnt = UBound(crit, 1)
    ReDim indArr(1 To critCnt)

    For critInd = 1 To critCnt
        ind = maxInd
        gefunden = False
        While ind >= 1 And Not gefunden
            If Arr(ind, 1) <> crit(critInd) Then
                ind = ind - 1
            Else
                gefunden = True
            End If
        Wend
        If Not gefunden Then
            indArr(critInd) = -1
        Else
            indArr(critInd) = ind
        End If
    Next

    SeqLookupExactDesc = indArr
End Function

Function SeqLookupAsc(Arr As Variant, crit As Variant, mMode As Long)
    Dim indArr As Variant
    Dim maxInd As Long
    Dim critCnt As Long
    Dim critInd As Long
    Dim ind As Long
    Dim gefunden As Boolean
    Dim uppClosest As Variant
    Dim lowClosest As Variant
    Dim uppInd As Long
    Dim lowInd As Long

    maxInd = UBound(Arr, 1)
    critCnt = UBound(crit, 1)
    ReDim indArr(1 To critCnt)

    For critInd = 1 To critCnt
        If mMode < 2 Then    'mMode -1, 0, 1
            ind = 1
            gefunden = False
            uppInd = -1
            lowInd = -1
            While ind <= maxInd And Not gefunden
                If Arr(ind, 1) > crit(critInd) Then
                    If uppInd = -1 Then
                        uppInd = ind
                        uppClosest = Arr(ind, 1)
                    Else
                        If Arr(ind, 1) < uppClosest Then
                            uppInd = ind
                            uppClosest = Arr(ind, 1)
                        End If
                    End If
                    ind = ind + 1
                ElseIf Arr(ind, 1) < crit(critInd) Then
                    If lowInd = -1 Then
                        lowInd = ind
                        lowClosest = Arr(ind, 1)
                    Else
                        If Arr(ind, 1) > lowClosest Then
                            lowInd = ind
                            lowClosest = Arr(ind, 1)
                        End If
                    End If
                    ind = ind + 1
                Else
                    gefunden = True
                End If
            Wend
            If Not gefunden Then
                If mMode = 1 Then
                    indArr(critInd) = uppInd
                ElseIf mMode = -1 Then
                    indArr(critInd) = lowInd
                Else
                    indArr(critInd) = -1
                End If
            Else
                indArr(critInd) = ind
            End If
        Else  'mMode = 2
            ind = 1
            gefunden = False
            While ind <= maxInd And Not gefunden
                If Not (Arr(ind, 1) Like crit(critInd)) Then
                    ind = ind + 1
                Else
                    gefunden = True
                End If
            Wend
            If Not gefunden Then
                indArr(critInd) = -1
            Else
                indArr(critInd) = ind
            End If
        End If
    Next
    
    SeqLookupAsc = indArr
End Function

